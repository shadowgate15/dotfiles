#!/usr/bin/env bash
set -euo pipefail

# Worktree lifecycle for ralph-issues: the sole place `git worktree` and `wt`
# are invoked from ralph-issues. Orchestration code calls only this script's
# subcommand interface, never `git worktree` or `wt` directly.

usage() {
  cat <<'EOF'
Usage: worktree <subcommand> [args...]

Subcommands:
  create <repo-root> <issue-number> [<base-ref>]
      Create a dedicated, disposable git worktree and branch scoped to
      <issue-number>, branched from <base-ref> (default: the repo's current
      HEAD). Prints the worktree's absolute path on stdout. If a worktree
      already exists for this issue, does nothing and prints its existing
      path instead of creating a second one.

  path <repo-root> <issue-number>
      Print the worktree path that would be used for <issue-number>,
      without creating anything.

  branch-name <issue-number>
      Print the branch name that would be used for <issue-number>,
      without creating anything.

  discard <repo-root> <issue-number>
      Remove the disposable worktree for <issue-number> (the branch itself
      is left alone). Used once a sub-issue's work has been merged into the
      run's shared integration branch and its worktree is no longer needed.

  integration-branch-name <parent-issue>
      Print the shared integration branch name that would be used for
      <parent-issue>, without creating anything.

  integration-path <repo-root> <parent-issue>
      Print the dedicated worktree path used to merge into <parent-issue>'s
      shared integration branch, without creating anything.

  create-integration <repo-root> <parent-issue> [<base-ref>]
      Create the dedicated, persistent worktree and branch used to merge
      verified sub-issues' work into <parent-issue>'s shared integration
      branch, branched from <base-ref> (default: the repo's current HEAD).
      Prints the worktree's absolute path on stdout. If it already exists,
      does nothing and prints its existing path instead of recreating it.
EOF
}

fail() {
  echo "Error: $1" >&2
  usage >&2
  exit 1
}

is_issue_number() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

# Backend seam: create/create-integration/discard/path/integration-path all
# route through resolve_backend() before doing anything else. `auto` selects
# `wt` when it's on PATH, falling back to `git` otherwise.
resolve_backend() {
  local requested="${RALPH_WORKTREE_BACKEND:-auto}"

  case "${requested}" in
    git) echo "git" ;;
    wt) echo "wt" ;;
    auto)
      if command -v wt >/dev/null 2>&1; then
        echo "wt"
      else
        echo "git"
      fi
      ;;
    *) fail "invalid RALPH_WORKTREE_BACKEND '${requested}' (expected git, wt, or auto)" ;;
  esac
}

branch_name() {
  echo "ralph-issues/issue-$1"
}

integration_branch_name() {
  echo "ralph-issues/parent-$1-integration"
}

git_worktree_path() {
  local repo_root="$1" issue="$2"
  local parent base
  parent="$(cd "$(dirname "${repo_root}")" && pwd)"
  base="$(basename "${repo_root}")"
  echo "${parent}/${base}.ralph-worktrees/issue-${issue}"
}

git_integration_worktree_path() {
  local repo_root="$1" parent="$2"
  local parent_dir base
  parent_dir="$(cd "$(dirname "${repo_root}")" && pwd)"
  base="$(basename "${repo_root}")"
  echo "${parent_dir}/${base}.ralph-worktrees/parent-${parent}-integration"
}

# wt-backend helpers. `wt` owns worktree placement via its own template;
# lib/worktree only reports the path `wt` chose. `switch` is always invoked
# without `--yes` (so its approval prompts reach the user) and with `--no-cd`
# (so no caller's cwd is disturbed); WORKTRUNK_DIRECTIVE_CD_FILE is never
# set. `--no-cd` only applies to `switch`; `list`/`remove` never change cwd.

require_wt() {
  command -v wt >/dev/null 2>&1 || fail "the \`wt\` CLI is required but was not found on PATH."
  command -v jq >/dev/null 2>&1 || fail "\`jq\` is required but was not found on PATH."
}

wt_list_branches() {
  local repo_root="$1"
  wt -C "${repo_root}" list --branches --format json 2>/dev/null \
    || fail "wt list failed in '${repo_root}'"
}

wt_branch_exists() {
  local repo_root="$1" branch="$2"
  jq -e --arg b "${branch}" 'any(.items[]; .branch == $b)' >/dev/null <<<"$(wt_list_branches "${repo_root}")"
}

wt_worktree_exists() {
  local repo_root="$1" branch="$2"
  jq -e --arg b "${branch}" 'any(.items[]; .branch == $b and .worktree.path != null)' >/dev/null \
    <<<"$(wt_list_branches "${repo_root}")"
}

wt_ensure_worktree() {
  local repo_root="$1" branch="$2" base_ref="$3"
  local result

  if wt_branch_exists "${repo_root}" "${branch}"; then
    result="$(wt -C "${repo_root}" switch "${branch}" --no-cd --format json)" \
      || fail "wt switch failed for branch '${branch}'"
  else
    result="$(wt -C "${repo_root}" switch --create "${branch}" --base "${base_ref}" --no-cd --format json)" \
      || fail "wt switch --create failed for branch '${branch}'"
  fi

  jq -r '.path' <<<"${result}"
}

wt_discard_worktree() {
  local repo_root="$1" branch="$2"

  wt_worktree_exists "${repo_root}" "${branch}" || return 0

  wt -C "${repo_root}" remove "${branch}" --no-delete-branch --foreground >/dev/null \
    || fail "wt remove failed for branch '${branch}'"
}

# worktree_path is kept under its original name since worktree.bats sources
# this file and calls it directly as a pure helper.
worktree_path() {
  git_worktree_path "$@"
}

cmd_path() {
  local repo_root="${1:-}" issue="${2:-}"
  [[ -n "${repo_root}" && -n "${issue}" ]] || fail "path requires <repo-root> <issue-number>"
  is_issue_number "${issue}" || fail "invalid issue number '${issue}'"

  local backend
  backend="$(resolve_backend)"
  case "${backend}" in
    git) git_worktree_path "${repo_root}" "${issue}" ;;
    wt) fail "path is not supported under the wt backend (the path is not predictable before creation)" ;;
    *) fail "unhandled backend '${backend}'" ;;
  esac
}

cmd_branch_name() {
  local issue="${1:-}"
  [[ -n "${issue}" ]] || fail "branch-name requires <issue-number>"
  is_issue_number "${issue}" || fail "invalid issue number '${issue}'"
  branch_name "${issue}"
}

# Creates a worktree at <path> on <branch> (branching off <base_ref> if
# <branch> doesn't exist yet), reusing an existing worktree at <path>
# instead of recreating it. Shared by cmd_create and cmd_create_integration,
# which differ only in how they name <branch> and <path>.
git_ensure_worktree() {
  local repo_root="$1" branch="$2" path="$3" base_ref="$4"

  if [[ -d "${path}" ]]; then
    echo "${path}"
    return 0
  fi

  mkdir -p "$(dirname "${path}")"

  if git -C "${repo_root}" show-ref --verify --quiet "refs/heads/${branch}"; then
    git -C "${repo_root}" worktree add --quiet "${path}" "${branch}"
  else
    git -C "${repo_root}" worktree add --quiet -b "${branch}" "${path}" "${base_ref}"
  fi

  echo "${path}"
}

git_discard_worktree() {
  local repo_root="$1" path="$2"

  [[ -d "${path}" ]] || return 0

  git -C "${repo_root}" worktree remove --force "${path}"
}

cmd_create() {
  local repo_root="${1:-}" issue="${2:-}" base_ref="${3:-HEAD}"
  [[ -n "${repo_root}" && -n "${issue}" ]] || fail "create requires <repo-root> <issue-number> [<base-ref>]"
  is_issue_number "${issue}" || fail "invalid issue number '${issue}'"

  local backend
  backend="$(resolve_backend)"
  case "${backend}" in
    git) git_ensure_worktree "${repo_root}" "$(branch_name "${issue}")" "$(git_worktree_path "${repo_root}" "${issue}")" "${base_ref}" ;;
    wt) require_wt; wt_ensure_worktree "${repo_root}" "$(branch_name "${issue}")" "${base_ref}" ;;
    *) fail "unhandled backend '${backend}'" ;;
  esac
}

cmd_discard() {
  local repo_root="${1:-}" issue="${2:-}"
  [[ -n "${repo_root}" && -n "${issue}" ]] || fail "discard requires <repo-root> <issue-number>"
  is_issue_number "${issue}" || fail "invalid issue number '${issue}'"

  local backend
  backend="$(resolve_backend)"
  case "${backend}" in
    git) git_discard_worktree "${repo_root}" "$(git_worktree_path "${repo_root}" "${issue}")" ;;
    wt) require_wt; wt_discard_worktree "${repo_root}" "$(branch_name "${issue}")" ;;
    *) fail "unhandled backend '${backend}'" ;;
  esac
}

cmd_integration_branch_name() {
  local parent="${1:-}"
  [[ -n "${parent}" ]] || fail "integration-branch-name requires <parent-issue>"
  is_issue_number "${parent}" || fail "invalid parent issue number '${parent}'"
  integration_branch_name "${parent}"
}

cmd_integration_path() {
  local repo_root="${1:-}" parent="${2:-}"
  [[ -n "${repo_root}" && -n "${parent}" ]] || fail "integration-path requires <repo-root> <parent-issue>"
  is_issue_number "${parent}" || fail "invalid parent issue number '${parent}'"

  local backend
  backend="$(resolve_backend)"
  case "${backend}" in
    git) git_integration_worktree_path "${repo_root}" "${parent}" ;;
    wt) fail "integration-path is not supported under the wt backend (the path is not predictable before creation)" ;;
    *) fail "unhandled backend '${backend}'" ;;
  esac
}

cmd_create_integration() {
  local repo_root="${1:-}" parent="${2:-}" base_ref="${3:-HEAD}"
  [[ -n "${repo_root}" && -n "${parent}" ]] || fail "create-integration requires <repo-root> <parent-issue> [<base-ref>]"
  is_issue_number "${parent}" || fail "invalid parent issue number '${parent}'"

  local backend
  backend="$(resolve_backend)"
  case "${backend}" in
    git) git_ensure_worktree "${repo_root}" "$(integration_branch_name "${parent}")" "$(git_integration_worktree_path "${repo_root}" "${parent}")" "${base_ref}" ;;
    wt) require_wt; wt_ensure_worktree "${repo_root}" "$(integration_branch_name "${parent}")" "${base_ref}" ;;
    *) fail "unhandled backend '${backend}'" ;;
  esac
}

main() {
  local sub="${1:-}"

  if [[ -z "${sub}" ]]; then
    usage >&2
    exit 1
  fi
  if [[ "${sub}" == "-h" || "${sub}" == "--help" ]]; then
    usage
    exit 0
  fi
  shift

  case "${sub}" in
    create) cmd_create "$@" ;;
    path) cmd_path "$@" ;;
    branch-name) cmd_branch_name "$@" ;;
    discard) cmd_discard "$@" ;;
    integration-branch-name) cmd_integration_branch_name "$@" ;;
    integration-path) cmd_integration_path "$@" ;;
    create-integration) cmd_create_integration "$@" ;;
    *) fail "unknown subcommand '${sub}'" ;;
  esac
}

# Guarded so bats can `source` this file to unit-test pure helpers (e.g.
# worktree_path) without triggering a `git worktree` call.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
