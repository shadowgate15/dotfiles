#!/usr/bin/env bash
set -euo pipefail

# Single sub-issue pipeline: wires the implement and confirmation attempts
# (lib/implement-attempt, lib/confirmation-attempt) into a retry loop with a
# configurable ceiling, reusing the same worktree across retries. On a
# passing confirmation, this script -- never the implementing attempt
# itself -- merges the sub-issue's branch into the run's shared integration
# branch, discards the worktree, and posts a summary comment closing the
# sub-issue via the adapter. On exhausting retries without a pass, the
# sub-issue is labeled for human follow-up instead, and its worktree and
# branch are left in place rather than discarded.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMPLEMENT_ATTEMPT="${SCRIPT_DIR}/implement-attempt"
CONFIRMATION_ATTEMPT="${SCRIPT_DIR}/confirmation-attempt"
GITHUB_ADAPTER="${SCRIPT_DIR}/github-adapter"
WORKTREE="${SCRIPT_DIR}/worktree"

DEFAULT_MAX_ATTEMPTS=3
ESCALATION_LABEL="needs-human"

usage() {
  cat <<'EOF'
Usage: sub-issue-pipeline run <repo-root> <worktree-dir> <base-ref> <repo> <parent-issue> <issue-number> <issue-title> [<max-attempts>]

Runs the implement/confirm inner loop for a single, already-claimed
sub-issue, up to <max-attempts> (default 3) attempts, reusing
<worktree-dir> across retries.

On a passing confirmation: merges the sub-issue's branch into
<parent-issue>'s shared integration branch, discards <worktree-dir>, and
closes the sub-issue via the adapter with a summary comment. Exits 0.

On exhausting <max-attempts> without a pass: labels the sub-issue
"needs-human" via the adapter and posts a comment summarizing the last
verdict, leaving <worktree-dir> and its branch in place. Exits 1.

Either way, prints a final `SUBISSUE_COST_USD=<amount>` line -- the summed
dollar cost of every implement/confirm attempt made for this sub-issue.
EOF
}

fail() {
  echo "Error: $1" >&2
  usage >&2
  exit 1
}

# Like `fail`, but for a runtime outcome (e.g. a merge conflict) rather than
# a usage error -- no point dumping usage for that.
runtime_fail() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

is_issue_number() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_owner_slash_repo() {
  [[ "$1" =~ ^[^/]+/[^/]+$ ]]
}

build_close_comment() {
  local attempt="$1" max_attempts="$2" confirmation_output="$3"
  printf 'Implemented and independently verified by ralph-issues automation (pass on attempt %s/%s).\n\n%s\n' \
    "${attempt}" "${max_attempts}" "${confirmation_output}"
}

build_escalation_comment() {
  local issue="$1" max_attempts="$2" confirmation_output="$3"
  printf 'ralph-issues automation exhausted %s attempt(s) on this sub-issue without an independent confirmation pass. Its worktree and branch have been left in place for human follow-up.\n\nLast verdict:\n%s\n' \
    "${max_attempts}" "${confirmation_output}"
}

# Pulls the last `COST_USD=<amount>` line out of an implement-attempt or
# confirmation-attempt invocation's output, defaulting to 0 if none is
# present (e.g. a session that errored out before reporting one).
extract_cost() {
  local text="$1"
  local cost
  cost="$(grep -oE '^COST_USD=[0-9.eE+-]+' <<<"${text}" | tail -n1 | cut -d= -f2)" || true
  echo "${cost:-0}"
}

# Removes `COST_USD=...` bookkeeping lines before attempt output is quoted
# back into a human-facing GitHub comment.
strip_cost_line() {
  grep -v '^COST_USD=' <<<"$1" || true
}

# Sums any number of dollar amounts (floating point) and prints the total.
sum_costs() {
  awk -v amounts="$*" 'BEGIN { n = split(amounts, a, " "); total = 0; for (i = 1; i <= n; i++) total += a[i]; printf "%.6f", total }'
}

merge_into_integration() {
  local repo_root="$1" parent="$2" issue="$3" base_ref="$4"

  local integration_path issue_branch
  integration_path="$("${WORKTREE}" create-integration "${repo_root}" "${parent}" "${base_ref}")"
  issue_branch="$("${WORKTREE}" branch-name "${issue}")"

  git -C "${integration_path}" merge --no-edit "${issue_branch}"
}

cmd_run() {
  local repo_root="${1:-}" worktree_dir="${2:-}" base_ref="${3:-}" repo="${4:-}" \
    parent="${5:-}" issue="${6:-}" title="${7:-}" max_attempts="${8:-${DEFAULT_MAX_ATTEMPTS}}"

  [[ -n "${repo_root}" && -n "${worktree_dir}" && -n "${base_ref}" && -n "${repo}" \
    && -n "${parent}" && -n "${issue}" && -n "${title}" ]] \
    || fail "run requires <repo-root> <worktree-dir> <base-ref> <repo> <parent-issue> <issue-number> <issue-title> [<max-attempts>]"
  [[ -d "${repo_root}" ]] || fail "repo root '${repo_root}' does not exist"
  [[ -d "${worktree_dir}" ]] || fail "worktree directory '${worktree_dir}' does not exist"
  is_owner_slash_repo "${repo}" || fail "invalid <owner/repo> value '${repo}'"
  is_issue_number "${parent}" || fail "invalid parent issue number '${parent}'"
  is_issue_number "${issue}" || fail "invalid issue number '${issue}'"
  is_issue_number "${max_attempts}" || fail "invalid max-attempts value '${max_attempts}' -- must be a positive integer"

  local attempt=1
  local last_confirmation_output=""
  local total_cost="0"

  while (( attempt <= max_attempts )); do
    echo "ralph-issues: implement/confirm attempt ${attempt}/${max_attempts} for #${issue}..."

    # Piped through `tee` (rather than plain command substitution) so each
    # attempt's output still streams live to the terminal -- required for
    # progress visibility during an unattended run -- while also being
    # captured here to pull out its `COST_USD=<amount>` line.
    local implement_tmp
    implement_tmp="$(mktemp)"
    "${IMPLEMENT_ATTEMPT}" run "${worktree_dir}" "${issue}" "${title}" 2>&1 | tee "${implement_tmp}" || true
    local implement_cost
    implement_cost="$(extract_cost "$(cat "${implement_tmp}")")"
    rm -f "${implement_tmp}"

    local confirm_tmp confirm_status=0
    confirm_tmp="$(mktemp)"
    "${CONFIRMATION_ATTEMPT}" run "${worktree_dir}" "${base_ref}" "${issue}" "${title}" 2>&1 | tee "${confirm_tmp}" || confirm_status=$?
    local confirmation_output
    confirmation_output="$(cat "${confirm_tmp}")"
    rm -f "${confirm_tmp}"

    local confirm_cost
    confirm_cost="$(extract_cost "${confirmation_output}")"
    confirmation_output="$(strip_cost_line "${confirmation_output}")"
    total_cost="$(sum_costs "${total_cost}" "${implement_cost}" "${confirm_cost}")"

    if [[ ${confirm_status} -eq 0 ]]; then
      merge_into_integration "${repo_root}" "${parent}" "${issue}" "${base_ref}" \
        || runtime_fail "merging #${issue}'s branch into the integration branch failed -- worktree and branch left in place for manual resolution"

      "${WORKTREE}" discard "${repo_root}" "${issue}"

      local comment
      comment="$(build_close_comment "${attempt}" "${max_attempts}" "${confirmation_output}")"
      "${GITHUB_ADAPTER}" close "${repo}" "${issue}" "${comment}" >/dev/null

      echo "ralph-issues: #${issue} confirmed and closed, merged into $("${WORKTREE}" integration-branch-name "${parent}")."
      echo "SUBISSUE_COST_USD=${total_cost}"
      return 0
    fi

    last_confirmation_output="${confirmation_output}"
    attempt=$((attempt + 1))
  done

  local escalation_comment
  escalation_comment="$(build_escalation_comment "${issue}" "${max_attempts}" "${last_confirmation_output}")"
  "${GITHUB_ADAPTER}" comment "${repo}" "${issue}" "${escalation_comment}" >/dev/null
  "${GITHUB_ADAPTER}" label "${repo}" "${issue}" "${ESCALATION_LABEL}" >/dev/null

  echo "ralph-issues: #${issue} escalated for human follow-up after ${max_attempts} attempt(s); worktree and branch left in place."
  echo "SUBISSUE_COST_USD=${total_cost}"
  return 1
}

main() {
  local sub="${1:-}"

  if [[ -z "${sub}" ]]; then
    usage >&2
    exit 1
  fi
  if [[ "${sub}" == "-h" || "${sub}" == "--help" ]]; then
    usage
    exit 0
  fi
  shift

  case "${sub}" in
    run) cmd_run "$@" ;;
    *) fail "unknown subcommand '${sub}'" ;;
  esac
}

# Guarded so bats can `source` this file to unit-test pure helpers (e.g.
# build_close_comment) without triggering claude/gh/git calls.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
