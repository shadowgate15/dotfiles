#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"
FRONTIER_QUERY="${LIB_DIR}/frontier-query"
WORKTREE="${LIB_DIR}/worktree"
# Overridable so bats can substitute a stub (e.g. one that crashes before
# its own escalation code runs) to exercise the outer loop's backstop below
# without a real implement/confirm pipeline.
SUB_ISSUE_PIPELINE="${SUB_ISSUE_PIPELINE:-${LIB_DIR}/sub-issue-pipeline}"

DEFAULT_MAX_ATTEMPTS=3
DEFAULT_MAX_MINUTES=240
DEFAULT_TRACKER="github"
READY_FOR_AGENT_LABEL="ready-for-agent"
ESCALATION_LABEL="ready-for-human"

usage() {
  cat <<'EOF'
Usage: ralph-issues <parent-issue-number> [--repo <owner/repo>] [--tracker <github|forge>] [--max-attempts <n>] [--max-minutes <n>]

Arguments:
  <parent-issue-number>  The parent GitHub issue whose sub-issues will be worked.

Options:
  --repo <owner/repo>    Target repo to operate on. Defaults to the current
                          checkout's repo, inferred from `git remote -v`.
  --tracker <name>       Issue tracker adapter to use: "github" or "forge".
                          Default: github.
  --max-attempts <n>     Retry ceiling for a sub-issue's implement/confirm
                          inner loop. Default: 3.
  --max-minutes <n>      Whole-run wall-clock ceiling, in minutes. Checked
                          between sub-issues, never mid-attempt. Default: 240.
  -h, --help             Show this help message.
EOF
}

fail() {
  echo "Error: $1" >&2
  usage >&2
  exit 1
}

is_owner_slash_repo() {
  [[ "$1" =~ ^[^/]+/[^/]+$ ]]
}

is_positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_supported_tracker() {
  [[ "$1" == "github" || "$1" == "forge" ]]
}

# Unlike --max-attempts (a retry count, where zero is meaningless), zero is
# a legitimate --max-minutes value: "stop before working any sub-issue".
# No leading zeros allowed -- besides being a weird way to write a number,
# a leading-zero literal (e.g. "010") is octal in bash arithmetic, which
# would silently misinterpret it in wall_clock_ceiling_reached's `* 60`.
is_nonnegative_integer() {
  [[ "$1" =~ ^(0|[1-9][0-9]*)$ ]]
}

# True (exit 0) once <elapsed_seconds> has reached or passed <max_minutes>.
wall_clock_ceiling_reached() {
  local elapsed_seconds="$1" max_minutes="$2"
  (( elapsed_seconds >= max_minutes * 60 ))
}

# Prints every already-processed sub-issue's outcome, one per line, so an
# unattended run's progress is visible without digging through logs. Prints
# nothing at all if nothing has been processed yet, so a run that finds no
# ready sub-issue on its very first pass still prints a single clean line.
print_processed_summary() {
  local -n _items="$1"
  [[ ${#_items[@]} -gt 0 ]] || return 0

  echo "Processed so far:"
  local line
  for line in "${_items[@]}"; do
    echo "  ${line}"
  done
}

infer_repo_from_git_remote() {
  local remote_url
  remote_url="$(git remote get-url origin 2>/dev/null)" || {
    echo "Error: could not infer target repo — no \`origin\` git remote found in the current checkout. Pass --repo <owner/repo> instead." >&2
    exit 1
  }

  local repo
  repo="$(echo "${remote_url}" | sed -E 's#^git@github\.com:(.+)\.git$#\1#; s#^https://github\.com/(.+)\.git$#\1#; s#^https://github\.com/(.+)$#\1#')"

  if [[ "${repo}" == "${remote_url}" ]] || ! is_owner_slash_repo "${repo}"; then
    echo "Error: could not infer target repo from git remote '${remote_url}'. Pass --repo <owner/repo> instead." >&2
    exit 1
  fi

  echo "${repo}"
}

# Under --tracker forge there is no owner/repo to infer -- forge derives its
# own project scope from the git remote (falling back to the current
# directory's basename outside a git repo). This is the one call to `forge`
# itself made outside lib/forge-adapter, since it's purely for the on-screen
# scope label rather than a tracker operation the adapter interface covers.
resolve_forge_scope() {
  command -v forge >/dev/null 2>&1 || {
    echo "Error: the \`forge\` CLI is required but was not found on PATH." >&2
    exit 1
  }
  forge project || {
    echo "Error: \`forge project\` failed to resolve the current project scope." >&2
    exit 1
  }
}

main() {
  local parent_issue=""
  local repo_override=""
  local tracker="${DEFAULT_TRACKER}"
  local max_attempts="${DEFAULT_MAX_ATTEMPTS}"
  local max_minutes="${DEFAULT_MAX_MINUTES}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --repo)
        [[ $# -ge 2 ]] || fail "--repo requires a value"
        repo_override="$2"
        shift 2
        ;;
      --repo=*)
        repo_override="${1#--repo=}"
        shift
        ;;
      --tracker)
        [[ $# -ge 2 ]] || fail "--tracker requires a value"
        tracker="$2"
        shift 2
        ;;
      --tracker=*)
        tracker="${1#--tracker=}"
        shift
        ;;
      --max-attempts)
        [[ $# -ge 2 ]] || fail "--max-attempts requires a value"
        max_attempts="$2"
        shift 2
        ;;
      --max-attempts=*)
        max_attempts="${1#--max-attempts=}"
        shift
        ;;
      --max-minutes)
        [[ $# -ge 2 ]] || fail "--max-minutes requires a value"
        max_minutes="$2"
        shift 2
        ;;
      --max-minutes=*)
        max_minutes="${1#--max-minutes=}"
        shift
        ;;
      -*)
        fail "unknown option '$1'"
        ;;
      *)
        if [[ -n "${parent_issue}" ]]; then
          fail "unexpected argument '$1'"
        fi
        parent_issue="$1"
        shift
        ;;
    esac
  done

  [[ -n "${parent_issue}" ]] || fail "missing required <parent-issue-number>"
  [[ "${parent_issue}" =~ ^[1-9][0-9]*$ ]] || fail "invalid parent issue number '${parent_issue}' — must be a positive integer"
  is_positive_integer "${max_attempts}" || fail "invalid --max-attempts value '${max_attempts}' — must be a positive integer"
  is_nonnegative_integer "${max_minutes}" || fail "invalid --max-minutes value '${max_minutes}' — must be a non-negative integer"
  is_supported_tracker "${tracker}" || fail "invalid --tracker value '${tracker}' — must be one of: github, forge"

  # Overridable so bats can substitute a stub adapter, and so `--tracker
  # forge` resolves to `lib/forge-adapter` instead of rewriting
  # orchestration code. Exported so the SUB_ISSUE_PIPELINE subprocess below
  # resolves the very same adapter rather than re-deriving it from a
  # --tracker flag it never sees.
  local TRACKER_ADAPTER="${TRACKER_ADAPTER:-${LIB_DIR}/${tracker}-adapter}"
  [[ -x "${TRACKER_ADAPTER}" ]] || fail "no adapter found for --tracker '${tracker}' (expected an executable at '${TRACKER_ADAPTER}')"
  export TRACKER_ADAPTER

  local repo
  if [[ -n "${repo_override}" ]]; then
    is_owner_slash_repo "${repo_override}" || fail "invalid --repo value '${repo_override}' — expected <owner/repo>"
    repo="${repo_override}"
  elif [[ "${tracker}" == "forge" ]]; then
    # Forge derives its own project scope; skip GitHub remote inference
    # entirely so a forge run works in a repo with no `origin` remote.
    repo="$(resolve_forge_scope)"
  else
    repo="$(infer_repo_from_git_remote)"
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "must be run from within a git checkout to create a worktree"

  local base_ref
  base_ref="$(git -C "${repo_root}" rev-parse HEAD)"

  local run_started
  run_started="$(date +%s)"
  local -a processed=()

  while true; do
    # Printed once at the top of every iteration (silently, if nothing has
    # finished yet) rather than only at a stopping point, so a run's
    # progress is visible on screen throughout -- including while the
    # sub-issue below is still being worked -- not just at the very end.
    print_processed_summary processed

    local elapsed
    elapsed=$(( $(date +%s) - run_started ))

    if wall_clock_ceiling_reached "${elapsed}" "${max_minutes}"; then
      echo "ralph-issues: stopping -- whole-run wall-clock ceiling of ${max_minutes} minute(s) reached ($(( elapsed / 60 )) minute(s) elapsed)."
      return 0
    fi

    local decision next_number
    decision="$("${TRACKER_ADAPTER}" frontier-input "${repo}" "${parent_issue}" | "${FRONTIER_QUERY}")"
    next_number="$(jq -r '.next // empty' <<<"${decision}")"

    if [[ -z "${next_number}" ]]; then
      echo "No ready sub-issue for parent #${parent_issue} in ${repo} (all sub-issues are blocked, assigned, or none exist)."
      return 0
    fi

    local next_title
    next_title="$("${TRACKER_ADAPTER}" title "${repo}" "${next_number}")"
    echo "Now working: #${next_number} ${next_title}"

    local worktree_dir worktree_branch
    worktree_dir="$("${WORKTREE}" create "${repo_root}" "${next_number}" "${base_ref}")"
    worktree_branch="$("${WORKTREE}" branch-name "${next_number}")"
    echo "Worktree: ${worktree_dir} (branch ${worktree_branch})"

    "${TRACKER_ADAPTER}" claim "${repo}" "${next_number}" >/dev/null

    # Defensively strip both poles right after assigning, so a sub-issue
    # never sits claimed alongside a stale ready-for-agent or ready-for-human
    # label left over from a previous run -- regardless of pipeline outcome,
    # exactly one of those two labels (if either) is meaningful once this
    # sub-issue is actually done, and that's decided below, not here.
    "${TRACKER_ADAPTER}" unlabel "${repo}" "${next_number}" "${READY_FOR_AGENT_LABEL}" >/dev/null
    "${TRACKER_ADAPTER}" unlabel "${repo}" "${next_number}" "${ESCALATION_LABEL}" >/dev/null
    echo "Claimed #${next_number}"

    echo "Running implement/confirm pipeline for #${next_number} in ${worktree_dir}..."

    local pipeline_status=0
    "${SUB_ISSUE_PIPELINE}" run "${repo_root}" "${worktree_dir}" "${base_ref}" "${repo}" \
      "${parent_issue}" "${next_number}" "${next_title}" "${max_attempts}" \
      || pipeline_status=$?

    if [[ ${pipeline_status} -ne 0 ]]; then
      # Safety-net backstop: idempotently re-apply the same parked-for-human
      # state the pipeline's own escalation path already sets on a normal
      # give-up, in case the pipeline instead crashed before reaching that
      # code (a bug, an unhandled signal, etc.) -- no open issue must ever be
      # left claimed but not parked. Each adapter call is already a no-op
      # when there's nothing to undo, so re-running them after a pipeline
      # that *did* escalate cleanly is harmless. This also fires if a crash
      # happens after a successful merge but before the pipeline's own
      # `close` call -- parking an already-merged issue for human review
      # rather than leaving it silently claimed is the intentional,
      # conservative side to fail on.
      "${TRACKER_ADAPTER}" unclaim "${repo}" "${next_number}" >/dev/null
      "${TRACKER_ADAPTER}" unlabel "${repo}" "${next_number}" "${READY_FOR_AGENT_LABEL}" >/dev/null
      "${TRACKER_ADAPTER}" label "${repo}" "${next_number}" "${ESCALATION_LABEL}" >/dev/null
    fi

    if [[ ${pipeline_status} -eq 0 ]]; then
      processed+=("#${next_number} ${next_title} -- confirmed and closed")

      # Later sub-issues branch from this run's integration branch (not the
      # commit the run started at), so each one builds on every sub-issue
      # already merged rather than diverging from stale starting state.
      local integration_branch
      integration_branch="$("${WORKTREE}" integration-branch-name "${parent_issue}")"
      base_ref="$(git -C "${repo_root}" rev-parse "${integration_branch}")"
    else
      processed+=("#${next_number} ${next_title} -- escalated for human follow-up")
    fi

    # Recomputed rather than reusing this iteration's `elapsed` from before
    # the sub-issue was worked -- that value is now stale by however long
    # the implement/confirm pipeline just took.
    local elapsed_now
    elapsed_now=$(( $(date +%s) - run_started ))
    echo "ralph-issues: run so far -- ${#processed[@]} sub-issue(s) processed, $(( elapsed_now / 60 )) minute(s) elapsed."
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
